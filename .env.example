ENVIRONMENT=development

POSTGRES_DB=smart_money
POSTGRES_USER=smart_money
POSTGRES_PASSWORD=CHANGE_ME

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME

OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_DEMO=true
OKX_REST_URL=https://www.okx.com
OKX_PUBLIC_WS_URL=wss://ws.okx.com:8443/ws/v5/public
OKX_BUSINESS_WS_URL=wss://ws.okx.com:8443/ws/v5/business
OKX_PRIVATE_WS_URL=wss://wspap.okx.com:8443/ws/v5/private
OKX_TRADING_ENABLED=false
OKX_MARGIN_MODE=cross
OKX_LIVE_MARKET_ENABLED=true
EXCHANGE_SYMBOLS=BTC-USDT-SWAP
EXCHANGE_TIMEFRAMES=M1,M5,M15,H1,H4,D1

SWING_LOOKBACK=5
CONFIDENCE_THRESHOLD=0.60
CONFLICT_MIN_DELTA=0.10
DEFAULT_CAPITAL=10000
ADAPTIVE_MODEL_WEIGHT=0.35
EXECUTION_MODE=paper
INITIAL_CAPITAL=10000
BASE_CURRENCY=USDT
MINIMUM_TRAINING_SAMPLES=20

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME
NEXT_PUBLIC_API_URL=http://localhost:8050
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8080
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=smart-money-api

# PostgreSQL memory budget (overrides host-based TimescaleDB tuning)
POSTGRES_MEMORY_LIMIT=3g
POSTGRES_SHARED_BUFFERS=512MB
