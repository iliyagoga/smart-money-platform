ENVIRONMENT=development

POSTGRES_DB=smart_money
POSTGRES_USER=smart_money
POSTGRES_PASSWORD=CHANGE_ME

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_USE_A_RANDOM_VALUE
REDIS_URL=redis://:CHANGE_ME_USE_A_RANDOM_VALUE@redis:6379


OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
OKX_DEMO=true
OKX_REST_URL=https://www.okx.com
OKX_PUBLIC_WS_URL=wss://ws.okx.com/ws/v5/public
OKX_BUSINESS_WS_URL=wss://ws.okx.com/ws/v5/business
OKX_PRIVATE_WS_URL=
OKX_TRADING_ENABLED=false
OKX_MARGIN_MODE=cross
OKX_LIVE_MARKET_ENABLED=true
# Store every OKX trade and order-book update (high disk usage). Candles work without this.
OKX_RAW_MARKET_DATA_ENABLED=false
EXCHANGE_SYMBOLS=BTC-USDT-SWAP
EXCHANGE_TIMEFRAMES=M1,M5,M15,M30,H1,H4,D1

CONFIDENCE_THRESHOLD=0.60
CONFLICT_MIN_DELTA=0.10
DEFAULT_CAPITAL=10000
EXECUTION_MODE=paper
INITIAL_CAPITAL=10000
BASE_CURRENCY=USDT

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_USE_A_RANDOM_VALUE
PUBLIC_FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8050
PUBLIC_KEYCLOAK_URL=http://localhost:8080
PUBLIC_API_HOSTS=localhost,127.0.0.1
DEPLOYMENT_BIND_ADDRESS=127.0.0.1
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=smart-money-api

# Required by docker-compose.production.yml; use DNS names without a scheme.
FRONTEND_HOST=app.example.com
API_HOST=api.example.com
KEYCLOAK_HOST=auth.example.com

# PostgreSQL memory budget (overrides host-based TimescaleDB tuning)
POSTGRES_MEMORY_LIMIT=3g
POSTGRES_SHARED_BUFFERS=512MB
